<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Max-priority messages open a full-screen alert, like an alarm clock -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:label="@string/kompakt_app_name"
        tools:replace="android:label">
        <activity
            android:name=".ui.MaxPriorityAlertActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:taskAffinity=".kompakt.alert"
            android:theme="@style/Theme.Ntfy.EInk.Alert"
            android:turnScreenOn="true" />
    </application>
</manifest>
