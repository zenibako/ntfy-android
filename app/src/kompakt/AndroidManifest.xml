<?xml version="1.0" encoding="utf-8"?>
<!-- Kompakt flavor: its own label, the full-screen alert for max-priority messages, and the
     launcher icon in the Kompakt's own style (a ring with a bell inside, black on transparent)
     instead of ntfy's green adaptive icon, which the E Ink launcher shows as a grey blob. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Max-priority messages open a full-screen alert, like an alarm clock -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:icon="@drawable/ic_launcher_mudita"
        android:label="@string/kompakt_app_name"
        android:roundIcon="@drawable/ic_launcher_mudita"
        tools:replace="android:icon,android:label,android:roundIcon">
        <activity
            android:name=".ui.MaxPriorityAlertActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:taskAffinity=".kompakt.alert"
            android:theme="@style/Theme.Ntfy.EInk.Alert"
            android:turnScreenOn="true" />

        <!-- Updating the app kills the subscriber service, and nothing restarts it until a
             reboot, an app launch or the 3-hourly worker, so urgent messages would wait. Also
             run the boot receiver after an update; it refreshes the service for any action. -->
        <receiver android:name="io.heckel.ntfy.service.SubscriberService$BootStartReceiver">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
