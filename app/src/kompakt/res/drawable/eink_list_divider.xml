<?xml version="1.0" encoding="utf-8"?>
<!-- E Ink message card foreground: an outlined bubble (eink_bubble); a selected (activated)
     card gets a 3dp outline instead of a grey fill. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/eink_bubble_selected" android:state_activated="true" />
    <item android:drawable="@drawable/eink_bubble" />
</selector>
