<?xml version="1.0" encoding="utf-8"?>
<!-- Settings divider: the topic list's dashed rule, inset like the preference text -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="@dimen/eink_row_inset_start" android:insetRight="@dimen/eink_row_inset_end">
    <shape android:shape="line">
        <stroke android:width="1dp" android:color="@android:color/black"
            android:dashWidth="4dp" android:dashGap="3dp" />
        <size android:height="2dp" />
    </shape>
</inset>
