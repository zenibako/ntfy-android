<?xml version="1.0" encoding="utf-8"?>
<!-- Send control with keyboard focus: the same square with a 3dp outline
     -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="40dp" android:height="40dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="3dp" android:color="@android:color/black" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item android:width="24dp" android:height="24dp" android:gravity="center"
        android:drawable="@drawable/eink_send_outline" />
</layer-list>
