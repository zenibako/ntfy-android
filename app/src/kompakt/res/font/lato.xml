<?xml version="1.0" encoding="utf-8"?>
<!-- Lato as the stock Kompakt apps use it: Medium (500) for content, Black (900) for titles,
     labels and buttons. There is no Lato Medium file here; 500 uses SemiBold, which matches the
     stock apps on the panel better than Regular. Files from MMD (OFL). -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font android:font="@font/lato_regular" android:fontStyle="normal" android:fontWeight="400"
        app:font="@font/lato_regular" app:fontStyle="normal" app:fontWeight="400" />
    <font android:font="@font/lato_italic" android:fontStyle="italic" android:fontWeight="400"
        app:font="@font/lato_italic" app:fontStyle="italic" app:fontWeight="400" />
    <font android:font="@font/lato_semi_bold" android:fontStyle="normal" android:fontWeight="500"
        app:font="@font/lato_semi_bold" app:fontStyle="normal" app:fontWeight="500" />
    <font android:font="@font/lato_bold" android:fontStyle="normal" android:fontWeight="700"
        app:font="@font/lato_bold" app:fontStyle="normal" app:fontWeight="700" />
    <font android:font="@font/lato_black" android:fontStyle="normal" android:fontWeight="900"
        app:font="@font/lato_black" app:fontStyle="normal" app:fontWeight="900" />
</font-family>
