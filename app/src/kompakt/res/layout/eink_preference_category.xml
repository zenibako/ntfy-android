<?xml version="1.0" encoding="utf-8"?>
<!-- Settings section header as in the stock Settings app: 21 sp Lato Black at the 16 dp text
     inset. Its own layout, because the stock preference category layout restyles its title. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/eink_row_inset_start"
    android:paddingTop="16dp"
    android:paddingEnd="@dimen/eink_row_inset_end"
    android:paddingBottom="8dp">

    <TextView
        android:id="@android:id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:textAppearance="@style/TextAppearance.EInk.PreferenceCategory"
        android:textColor="@android:color/black"
        android:textFontWeight="900" />
</LinearLayout>
