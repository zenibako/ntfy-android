<?xml version="1.0" encoding="utf-8"?>
<!-- E Ink message bar, like the compose bar in the Kompakt's Messages app and the Hermes app:
     a thick black rule, a borderless field and the outlined send square. Same view IDs as main's
     layout; "^" still opens the full publish dialog. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/eink_bar_rule"
        android:background="@android:color/black" />

    <LinearLayout
        android:id="@+id/message_bar_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/message_bar_expand_button"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/message_bar_expand_button_description"
            android:src="@drawable/ic_expand_less_gray_24dp"
            app:tint="@android:color/black" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/message_bar_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/eink_message_bar_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:minHeight="48dp"
            android:paddingStart="4dp"
            android:paddingTop="12dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColorHint="@android:color/black" />

        <!-- 48dp touch target around the 40dp outlined square; no fill, shadow or ripple -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/message_bar_publish_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:clickable="true"
            android:contentDescription="@string/message_bar_publish_button_description"
            android:focusable="true"
            android:src="@drawable/eink_send_button"
            app:backgroundTint="@android:color/transparent"
            app:borderWidth="0dp"
            app:elevation="0dp"
            app:fabCustomSize="48dp"
            app:hoveredFocusedTranslationZ="0dp"
            app:maxImageSize="40dp"
            app:pressedTranslationZ="0dp"
            app:rippleColor="@android:color/transparent"
            app:tint="@android:color/black" />
    </LinearLayout>
</LinearLayout>
